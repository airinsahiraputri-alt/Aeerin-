<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kotak Curhat Masa Depan</title>
    <style>
        :root {
            --bg-color: #0f172a;
            --card-bg: #1e293b;
            --text-color: #f8fafc;
            --accent-color: #38bdf8;
            --glow-color: #22d3ee;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
        }

        .container {
            width: 90%;
            max-width: 600px;
            background: var(--card-bg);
            padding: 2rem;
            border-radius: 15px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.3);
            text-align: center;
        }

        h1 {
            color: var(--accent-color);
            margin-bottom: 0.5rem;
        }

        p {
            font-size: 0.9rem;
            opacity: 0.8;
            margin-bottom: 1.5rem;
        }

        #input-area {
            width: 100%;
            height: 150px;
            background: #334155;
            border: 2px solid #475569;
            border-radius: 10px;
            padding: 15px;
            color: white;
            font-size: 1.1rem;
            resize: none;
            outline: none;
            box-sizing: border-box;
            transition: border-color 0.3s;
        }

        #input-area:focus {
            border-color: var(--accent-color);
        }

        .output-display {
            margin-top: 20px;
            padding: 15px;
            min-height: 50px;
            background: rgba(15, 23, 42, 0.5);
            border-radius: 10px;
            line-height: 1.6;
            text-align: left;
            word-wrap: break-word;
        }

        .positive-glow {
            color: var(--glow-color);
            font-weight: bold;
            text-shadow: 0 0 8px var(--glow-color), 0 0 15px var(--glow-color);
            display: inline-block;
            animation: pulse 1.5s infinite alternate;
        }

        @keyframes pulse {
            from { transform: scale(1); opacity: 0.8; }
            to { transform: scale(1.05); opacity: 1; }
        }
    </style>
</head>
<body>

<div class="container">
    <h1>Kotak Transformasi</h1>
    <p>Tuliskan kekhawatiranmu tentang masa depan di sini. Mari kita ubah sudut pandangnya.</p>
    
    <textarea id="input-area" placeholder="Ketik di sini... (contoh: Saya takut gagal)"></textarea>

    <div class="output-display" id="output-text">
        Hasil transformasi akan muncul di sini...
    </div>
</div>

<script>
    const inputArea = document.getElementById('input-area');
    const outputDisplay = document.getElementById('output-text');

    // Kamus kata negatif ke positif
    const wordMap = {
        "gagal": "sukses",
        "takut": "berani",
        "bodoh": "pintar",
        "sulit": "tantangan",
        "buruk": "baik",
        "menyerah": "berjuang",
        "sedih": "bahagia",
        "khawatir": "tenang",
        "lemah": "kuat"
    };

    inputArea.addEventListener('input', function() {
        let text = this.value;
        
        if (text.trim() === "") {
            outputDisplay.innerHTML = "Hasil transformasi akan muncul di sini...";
            return;
        }

        // Memisahkan teks menjadi kata-kata termasuk tanda baca
        let words = text.split(/(\s+)/); 

        let transformedWords = words.map(word => {
            let cleanWord = word.toLowerCase().replace(/[.,\/#!$%\^&\*;:{}=\-_`~()]/g,"");
            
            if (wordMap[cleanWord]) {
                // Mengambil versi positif dari kamus
                let positiveWord = wordMap[cleanWord];
                return `<span class="positive-glow">${positiveWord}</span>`;
            }
            return word;
        });

        outputDisplay.innerHTML = transformedWords.join('');
    });
</script>

</body>
</html>
